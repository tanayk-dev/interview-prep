---
import { getTopics, url } from '../lib/topics';
import { SITE } from '../site.config';

const { current } = Astro.props as { current?: string };
const topics = await getTopics();
const total = topics.reduce((n, t) => n + t.questions.length, 0);
---

<aside class="sidebar" id="sidebar">
  <div class="vault-head">
    <a href={url()} class="vault-name">
      <span class="vault-logo" aria-hidden="true">◆</span>
      {SITE.title}
    </a>
    <button class="icon-btn nav-close" data-close-nav aria-label="Close menu">
      <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </div>

  <nav class="explorer" aria-label="Topics">
    <a href={url()} class:list={['file', { active: !current }]}>
      <span class="file-icon">🏠</span><span class="file-name">Home &amp; plan</span>
    </a>
    <div class="explorer-label">Topics · {total} Q&amp;As</div>
    {
      topics.map((t) => (
        <a
          href={url(`${t.id}/`)}
          class:list={['file', 'topic-link', { active: current === t.id }]}
          style={`--c: var(--ctp-${t.data.color})`}
          data-topic={t.id}
          data-total={t.questions.length}
        >
          <span class="file-icon">{t.data.icon}</span>
          <span class="file-name">{t.data.short}</span>
          <span class="file-count" data-progress-label>{t.questions.length}</span>
          <span class="file-bar"><span data-progress-bar /></span>
        </a>
      ))
    }
  </nav>

  <div class="sidebar-foot">
    <button class="theme-toggle" data-theme-toggle aria-label="Toggle light / dark theme">
      <svg class="i-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
      <svg class="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      <span class="label-dark">Mocha</span><span class="label-light">Rosé Pine</span>
    </button>
    <button class="reset-btn" data-reset-progress title="Clear all ticked questions">Reset progress</button>
  </div>
</aside>
