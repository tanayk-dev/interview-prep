---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Search from '../components/Search.astro';
import { SITE } from '../site.config';
import { url } from '../lib/topics';

interface Props {
  title?: string;
  description?: string;
  current?: string; // topic id of the page, for the sidebar highlight
  crumbs?: string[];
}
const { title, description = SITE.tagline, current, crumbs = [] } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Pick the theme before first paint so there is no flash.
      (() => {
        let t = null;
        try { t = localStorage.getItem('ip:theme'); } catch {}
        if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <div class="app">
      <Sidebar current={current} />
      <div class="scrim" data-close-nav></div>
      <div class="main-col">
        <header class="topbar">
          <button class="icon-btn nav-toggle" data-open-nav aria-label="Open menu">
            <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={url()}>{SITE.title}</a>
            {crumbs.map((c) => <><span class="sep">/</span><span>{c}</span></>)}
          </nav>
          <button class="search-trigger" data-open-search aria-label="Search questions">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <span>Search questions</span>
            <kbd>Ctrl K</kbd>
          </button>
        </header>
        <slot />
      </div>
    </div>
    <Search />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
